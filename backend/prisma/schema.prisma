generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  phone     String?

  addresses Address[]
  wishlist  Wishlist[]
  cart      Cart[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  label       String   @default("Home")
  addressLine String
  city        String
  pincode     String
  isDefault   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("addresses")
}

model Wishlist {
  id        String   @id @default(cuid())

  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlists")
}

model Cart {
  id        String   @id @default(cuid())

  userId    String
  productId String

  qty Int @default(1)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@map("cart")
}

model Product {
  id               String        @id @default(cuid())
  name             String
  description      String        @default("")
  metal            Metal
  category         String
  purity           String
  grossWeight      Float?
  stoneWeight      Float?
  stoneCost        Float?
  hallmarkId       String?
  sku              String        @unique
  va               Float?
  isDirectSterling Boolean       @default(false)
  pieceCost        Float?
  image            String        @default("")
  status           ProductStatus @default(Draft)
  stock            Int           @default(0)
  sold             Int           @default(0)

  wishlist Wishlist[]
  cart      Cart[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gstRate Float? @default(3)

  @@map("products")
}

model Category {
  id        String   @id @default(cuid())
  metal     Metal
  name      String
  slug      String
  metaTitle String   @default("")
  metaDesc  String   @default("")
  image     String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([metal, slug])

  @@map("categories")
}

model Discount {
  id         String        @id @default(cuid())
  metal      Metal
  category   String
  productIds String[]
  scope      DiscountScope
  kind       DiscountKind
  value      Float
  createdAt  DateTime      @default(now())

  @@map("discounts")
}

model Reel {
  id          String   @id @default(cuid())
  title       String?
  instagramUrl String
  videoUrl    String   // 5-second MP4 video preview URL (uploaded via admin)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Metal {
  Gold
  Silver
}

enum ProductStatus {
  Active
  Inactive
  Draft
}

enum DiscountScope {
  VA
  Total
}

enum DiscountKind {
  percent
  flat
}